{
  "name": "crapette-backend",
  "version": "1.0.0",
  "description": "MVC server for crapette game",
  "license": "MIT",
  "author": "Jean Vrignaud",
  "type": "commonjs",
  "main": "./src/controller.ts",
  "scripts": {
    "start": "tsx ./src/controllerts",
    "dev": "tsx watch ./src/controller.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:ui": "rm -rf dist && cd ../frontend && npm run build && cp -r dist ../backend",
    "deploy:full": "npm run build:ui && git add . && git commit -m uibuild && git push"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
